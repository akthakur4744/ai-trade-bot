# ── Zerodha Kite Connect ──────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Kite auto-login (optional — enables scripts/kite_auto_login.py)
# Requires External TOTP enabled in Kite profile (Settings → Account → External 2FA TOTP).
# Values: no quotes; TOTP secret is 32 chars of A-Z and 2-7 only (no 0/1/8/9).
# SENSITIVE: `chmod 600 .env` and never commit. Automated login violates Zerodha ToS.
# KITE_USER_ID=AB1234
# KITE_PASSWORD=your_kite_password
# KITE_TOTP_SECRET=YOURBASE32SECRETEXACTLY32CHARS__

# ── Claude API ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Notifications — Telegram (free, recommended) ──────────────────────────────
# Interactive buttons for trade approval + auto-sell exit + memory update approval
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# Notifications — WhatsApp via Twilio (optional, paid)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_TO=whatsapp:+91xxxxxxxxxx

# ── Execution ─────────────────────────────────────────────────────────────────
# "paper" (default) or "live"
EXECUTION_MODE=paper

# ── Database (Supabase Postgres — free tier, Mumbai ap-south-1) ──────────────
# Engine picks the URL matching EXECUTION_MODE. Leaving both unset falls back
# to local SQLite (offline dev only — not for production).
#
# Use Pooler (Transaction mode, port 6543) for app runtime — better for
# serverless/short-lived connections (Fly.io worker, Cloud Routines).
# Use Direct (port 5432) only for one-off tools: alembic upgrade head, psql.
#
# Project refs:  paper → mgarzpkoxgicdacujhny   live → xagungelhyaqwokamayo
#
# Pooler (runtime):
# DATABASE_URL_PAPER=postgresql://postgres.mgarzpkoxgicdacujhny:pw@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_URL_LIVE=postgresql://postgres.xagungelhyaqwokamayo:pw@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Direct (alembic / psql only):
# DATABASE_URL_PAPER=postgresql://postgres:pw@db.mgarzpkoxgicdacujhny.supabase.co:5432/postgres
# DATABASE_URL_LIVE=postgresql://postgres:pw@db.xagungelhyaqwokamayo.supabase.co:5432/postgres

# ── GitHub (memory self-improvement loop) ────────────────────────────────────
# Required for memory updates: when a postmortem/weekly-review is approved via
# Telegram, MemoryWriter opens a GitHub PR so changes are reviewed before
# landing on main. No auto-merge — you merge manually on GitHub.
#
# Create a fine-grained PAT at https://github.com/settings/personal-access-tokens
# Scope to this repo only, with:
#   Repository permissions → Contents: Read & write
#   Repository permissions → Pull requests: Read & write
#
# In production this lives as a Fly.io secret (`fly secrets set GITHUB_TOKEN=...`)
# because MemoryWriter now runs inside the Fly.io trigger API (/trigger/poll),
# not in the CCR telegram-poll routine.
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=akthakur4744/ai-trade-bot   # optional — auto-detected from git remote
# MEMORY_PR_BASE=main                      # optional — base branch for memory PRs

# ── Heartbeat watchdog ────────────────────────────────────────────────────────
# Used by heartbeat, morning-login-prompt, signal-scan, memory-approval-sweeper
# Cloud Routines (HTTPS proxy — CCR sandbox blocks Postgres ports 5432/6543).
# HEARTBEAT_STATE_URL=https://your-worker.your-subdomain.workers.dev/heartbeat/state
# HEARTBEAT_TOKEN=your_secret_token   # mirror this to Cloudflare Worker secret

# ── Fly.io Trigger API ────────────────────────────────────────────────────────
# Used by signal-scan and telegram-poll Cloud Routines to delegate DB-heavy
# operations to the Fly.io worker (full Postgres access, HTTPS endpoint).
# Generate token: python -c "import secrets; print(secrets.token_hex(32))"
# Also set via: fly secrets set TRIGGER_API_TOKEN="<same value>"
# FLY_WORKER_URL=https://insight-alpha-auto-sell.fly.dev
# TRIGGER_API_TOKEN=your_random_64char_hex_token

# ── Web dashboard ─────────────────────────────────────────────────────────────
# PORT=8000
